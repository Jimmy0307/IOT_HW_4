# ---- Secrets & generated key material (NEVER commit) ----
secrets/
*.key
*.pem
*.p12
*.pfx
*.crt
*.csr
*.srl
dynamic-security.json
*.pw
web_credentials*.txt
.env
!.env.example

# ---- Runtime data ----
data/
*.db
*.db-wal
*.db-shm
*.sqlite

# ---- Generated evidence (regenerated by scripts/verify_all.py) ----
# Sanitized evidence summaries are committed explicitly via `git add -f`
evidence/generated/**/raw/

# ---- Python ----
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.venv/

# ---- Node ----
node_modules/
services/frontend/dist/
services/frontend/test-results/
playwright-report/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/
