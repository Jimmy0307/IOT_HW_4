# Copy to .env only if you need to override defaults. NO REAL SECRETS HERE.
# All secrets (MQTT passwords, JWT key, audit HMAC key, TLS keys) are generated
# by `python scripts/bootstrap_secrets.py` into ./secrets/ (gitignored) and are
# mounted into containers as files - never passed as environment variables.

# Host bind address/port for the HTTPS dashboard (reverse proxy only).
ORCHID_HTTPS_BIND=127.0.0.1
ORCHID_HTTPS_PORT=8443

# Compose project name (keeps container/network names predictable).
COMPOSE_PROJECT_NAME=orchid

# Placeholders documenting secret *names* (values live in ./secrets/):
# ORCHID_JWT_SECRET_FILE=/run/orchid-secrets/jwt_secret
# ORCHID_AUDIT_HMAC_KEY_FILE=/run/orchid-secrets/audit_hmac_key
# ORCHID_MQTT_PASSWORD_FILE=/run/orchid-secrets/mqtt.pw
